{
  "name": "dsh-processing-status",
  "version": "1.0.0",
  "description": "在 DSH 输入框上方显示处理中、计时和轮换趣味提示。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OStarsO/dsh-processing-status.git"
  },
  "homepage": "https://github.com/OStarsO/dsh-processing-status#readme",
  "bugs": {
    "url": "https://github.com/OStarsO/dsh-processing-status/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "processing-status",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "assets/preview.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
